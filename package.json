{
  "name": "@inovan.do/obsidian-rag-tools",
  "version": "1.1.1",
  "description": "CLI tools and MCP Server to validate, optimize, index vectors, and serve RAG-focused Obsidian vaults.",
  "main": "validate_vault.js",
  "preferGlobal": true,
  "bin": {
    "obsidian-rag-mcp": "./bin/mcp.js",
    "obsidian-rag-mcp-tcp": "./bin/mcp-tcp.js",
    "obsidian-rag-validate": "./bin/validate.js",
    "obsidian-rag-fix-density": "./bin/fix-density.js",
    "obsidian-rag-init": "./bin/init.js",
    "obsidian-rag-setup": "./bin/setup.js",
    "obsidian-rag-index": "./bin/index.js"
  },
  "files": [
    "lib",
    "bin",
    "templates",
    "mcp-server.js",
    "mcp-server-host.js",
    "validate_vault.js",
    "fix_token_density.js",
    "fix_yaml_duplicates.js",
    "fix_yaml_orphan_fields.js",
